-- =====================================================
--  ANTI-BAN / ANTI-DETECTION LAYER (ระบบกันแบนเบื้องต้น)
-- =====================================================
local function InitAntiCheatBypass()
    local gmt = getrawmetatable(game)
    setreadonly(gmt, false)
    local oldNamecall = gmt.__namecall
    
    gmt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        -- บล็อกการส่ง Signal ตรวจจับจาก Client ไปยัง Server (Hook/Ban Events)
        if method == "FireServer" and tostring(self):lower():find("ban") then
            return nil
        end
        return oldNamecall(self, ...)
    end)
    setreadonly(gmt, true)
end
pcall(InitAntiCheatBypass)

